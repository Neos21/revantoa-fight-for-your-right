{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fight-for-your-right",
  "compatibility_date": "2025-09-17",
  "account_id": "0d0188bb032f7edfb344a07f0afad3ee",
  "main": "./server/index.ts",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fight-for-your-right",
      "database_id": "103ed021-fe46-4957-804c-cb0ba45fb1a6"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "placement": {
    "mode": "smart"
  }
}
